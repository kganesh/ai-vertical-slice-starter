# Copy to .env.local. With no key set, the app runs in "AI fallback mode".

AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Optional overrides
# AI_MODEL=claude-sonnet-5-5      # default; claude-haiku-5-5 is faster/cheaper
# AI_BASE_URL=                    # only if they give you a gateway/proxy URL
# DATA_DIR=./.data                # where items.json lives (defaults to /tmp on Vercel)

# Alternative provider (not needed for 3Degrees)
# AI_PROVIDER=openai
# OPENAI_API_KEY=
