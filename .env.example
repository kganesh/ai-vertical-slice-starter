# Copy to .env.local. With no key set, the app runs in "AI fallback mode".

# Pick one (auto-detected from whichever key is present if AI_PROVIDER is unset)
AI_PROVIDER=openai
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional overrides
# AI_MODEL=gpt-4o-mini            # or claude-haiku-4-5, etc.
# AI_BASE_URL=                    # OpenAI-compatible gateway (Azure, LiteLLM, OpenRouter)
# DATA_DIR=./.data                # where items.json lives (defaults to /tmp on Vercel)
